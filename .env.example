# Copy this file to .env and fill in real values.

# Flask's session-signing secret. 
FLASK_SECRET_KEY=changeme-generate-a-random-64-char-hex-value

# Password pepper: an application-level secret mixed into every password
PASSWORD_PEPPER=changeme-generate-a-different-random-64-char-hex-value

# Example third-party credential that used to be hardcoded in source
EXTERNAL_API_KEY=changeme-your-real-api-key-here

# SQLite database file path.
DATABASE_PATH=app.db
